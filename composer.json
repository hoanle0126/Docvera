{
  "name": "docvera/docvera",
  "description": "Docvera — Privacy-First, Self-Hosted Document Processing Platform & REST API",
  "type": "project",
  "license": "Apache-2.0",
  "keywords": [
    "pdf",
    "document-processing",
    "ocr",
    "self-hosted",
    "privacy-first",
    "rest-api",
    "qpdf",
    "ghostscript",
    "poppler",
    "libreoffice",
    "tesseract"
  ],
  "require": {
    "php": ">=8.2",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "Docvera\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Docvera\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8080 -t public public/index.php",
    "test": "php bin/test",
    "lint": "find src bin public views tests config -name '*.php' -print0 | xargs -0 -n1 php -l",
    "capabilities": "php bin/capabilities",
    "install": "php bin/install",
    "install-check": "php bin/install --check-only",
    "migrate": "php bin/migrate",
    "cleanup": "php bin/cleanup",
    "worker": "php bin/worker --once",
    "package-release": "php bin/package-release"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
