#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use Docvera\Core\Application;

$app = new Application();
$newlyApplied = $app->migrator->migrate();
$applied = $app->migrator->getAppliedMigrations();

echo "Docvera Database Migrator (" . strtoupper($app->database->getDriverName()) . ")\n";
echo str_repeat('-', 56) . "\n";
foreach ($applied as $id) {
    $tag = in_array($id, $newlyApplied, true) ? '[NEW]' : '[OK ]';
    echo " " . $tag . " " . $id . "\n";
}
echo str_repeat('-', 56) . "\n";
echo sprintf("Total applied migrations: %d (%d newly applied)\n", count($applied), count($newlyApplied));
exit(0);

