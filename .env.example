# Docvera — Environment Configuration
APP_NAME="Docvera"
APP_ENV="production"
APP_DEBUG="false"
APP_URL="http://localhost:8080"
APP_TIMEZONE="UTC"
APP_INSTALLED="false"
APP_SECRET="change-this-to-a-64-char-random-secret-in-production-environment"

# Database Configuration
# Supported drivers: file (zero-config atomic store), sqlite (PDO SQLite), mysql (PDO MySQL/PostgreSQL)
DB_CONNECTION="file"
DB_DRIVER="file"
DB_DSN=""
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="docvera"
DB_USERNAME="root"
DB_PASSWORD=""
DB_SQLITE_PATH="storage/app/database/docvera.sqlite"

# File Upload & Processing Limits
MAX_FILE_SIZE_MB="50"
MAX_FILES_PER_JOB="20"
PROCESS_TIMEOUT_SECONDS="60"
RETENTION_TTL_MINUTES="60"

# Queue & Scheduler Settings
QUEUE_DRIVER="sync"
SCHEDULER_ENABLED="true"

# Phase 2 Deployment Mode & Commercial Billing (Optional — Configurable via /admin)
# Supported deployment modes: saas | free_ads | private
DEPLOYMENT_MODE="saas"

# Stripe Billing Credentials (Leave empty if unconfigured; never exposed to browser)
STRIPE_ENABLED="false"
STRIPE_MODE="test"
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal Billing Credentials (Leave empty if unconfigured; never exposed to browser)
PAYPAL_ENABLED="false"
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_SECRET=""

# Optional Explicit Binary Paths (auto-detected from PATH when empty)
BIN_GS=""
BIN_QPDF=""
BIN_PDFINFO=""
BIN_PDFTOPPM=""
BIN_PDFTOTEXT=""
BIN_PDFSEPARATE=""
BIN_PDFUNITE=""
BIN_LIBREOFFICE=""
BIN_TESSERACT=""
